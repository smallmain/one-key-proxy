@@ -0,0 +1,116 @@
+package protocol
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestSocks5SurgeLine(t *testing.T) {
+	tests := []struct {
+		name   string
+		link   string
+		config OutputConfig
+		want   string
+	}{
+		{
+			name:   "loopback without authentication",
+			link:   "socks5://127.0.0.1:7896#%5BSM%5D%E5%AE%B6%E5%AE%BD%20-%20%E6%9C%AC%E5%9C%B0",
+			config: OutputConfig{Udp: true},
+			want:   "[SM]\u5bb6\u5bbd - \u672c\u5730 = socks5, 127.0.0.1, 7896, udp-relay=true",
+		},
+		{
+			name: "percent encoded authentication is decoded once",
+			link: "socks5://user%40example:p%3Ass%2520@proxy.example:1080#Authenticated",
+			want: "Authenticated = socks5, proxy.example, 1080, username=user@example, password=p:ss%20, udp-relay=false",
+		},
+		{
+			name: "username without password",
+			link: "socks5://user@proxy.example:1080#User",
+			want: "User = socks5, proxy.example, 1080, username=user, udp-relay=false",
+		},
+		{
+			name: "IPv6 endpoint",
+			link: "socks5://[2001:db8::1]:1080#IPv6",
+			want: "IPv6 = socks5, 2001:db8::1, 1080, udp-relay=false",
+		},
+		{
+			name: "host replacement",
+			link: "socks5://proxy.example:1080#Mapped",
+			config: OutputConfig{ReplaceServerWithHost: true,
+				HostMap: map[string]string{"proxy.example": "192.0.2.1"}},
+			want: "Mapped = socks5, 192.0.2.1, 1080, udp-relay=false",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			line, name, err := buildSocks5SurgeLine(test.link, test.config)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if line != test.want {
+				t.Fatalf("got %q, want %q", line, test.want)
+			}
+			if name != strings.SplitN(test.want, " = ", 2)[0] {
+				t.Fatalf("wrong group member: %q", name)
+			}
+		})
+	}
+}
+
+func TestSocks5SurgeLineRejectsInvalidFields(t *testing.T) {
+	for _, link := range []string{
+		"not-a-node",
+		"socks5://proxy.example:0#Invalid",
+		"socks5://proxy.example:65536#Invalid",
+		"socks5://:1080#Invalid",
+		"socks5://user:pass%2Ctls%3Dtrue@proxy.example:1080#Invalid",
+		"socks5://proxy.example:1080#Invalid%0AInjected",
+		"socks5://proxy.example:1080#Invalid%3DName",
+		"socks5://user:pass%22word@proxy.example:1080#Invalid",
+	} {
+		t.Run(link, func(t *testing.T) {
+			line, name, err := buildSocks5SurgeLine(link, OutputConfig{})
+			if err == nil || line != "" || name != "" {
+				t.Fatalf("invalid link produced line=%q name=%q error=%v", line, name, err)
+			}
+		})
+	}
+}
+
+func TestEncodeSurgeIncludesSocks5NodesAndGroups(t *testing.T) {
+	link := "socks5://127.0.0.1:7896#Local"
+	if !ProtocolSupportsClient("socks5", ClientSurge) || !SupportsClientForLink(link, ClientSurge) {
+		t.Fatal("SOCKS5 must pass the Surge client capability filter")
+	}
+	if _, ok := detectProtocol(link).(SurgeCapable); !ok {
+		t.Fatal("SOCKS5 must implement SurgeCapable")
+	}
+	template := filepath.Join(t.TempDir(), "socks5-surge-regression.conf")
+	content := "[Proxy]\nDIRECT = direct\n\n[Proxy Group]\nAll = select\nResidential = select, include-all-proxies=true, policy-regex-filter=Residential\n"
+	if err := os.WriteFile(template, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ss := EncodeSSURL(Ss{Name: "ExistingSS", Server: "ss.example", Port: 8388,
+		Param: Param{Cipher: "aes-128-gcm", Password: "test-password"}})
+	output, err := EncodeSurge([]string{link, "socks5://127.0.0.1:7897#ResidentialLocal", ss},
+		OutputConfig{Surge: template, Udp: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{
+		"Local = socks5, 127.0.0.1, 7896, udp-relay=true",
+		"ResidentialLocal = socks5, 127.0.0.1, 7897, udp-relay=true",
+		"ExistingSS = ss, ss.example, 8388",
+		"All = select, Local, ResidentialLocal, ExistingSS",
+		"Residential = select, include-all-proxies=true, policy-regex-filter=Residential",
+	} {
+		if !strings.Contains(output, want) {
+			t.Errorf("missing %q in generated subscription", want)
+		}
+	}
+	if strings.Contains(output, "username=") || strings.Contains(output, "password=,") {
+		t.Fatal("unauthenticated SOCKS5 nodes must omit authentication parameters")
+	}
+}
