# Local configuration for: python3 deploy.py (interactive menu)
# Values are literal. Optional matching quotes are removed; no shell expansion.
# Keep this file private after copying it to .env (chmod 600 .env).
# SSH host passwords are entered at the --password terminal prompt, not stored here.

# Integration credentials stay on this computer. Templates are built into the project.
SUBLINKPRO_URL=
SUBLINKPRO_API_KEY=
# true configures BOTH sing-box and SublinkPro; false adds only the airport.
ENABLE_LOCAL_NODE=true
# Optional airport group override (built-in default: SM).
# SUBLINKPRO_GROUP=my-group
# Airport and node names are entered separately on first import, or supplied as:
# --airport-name "My HK VPS" --node-name "Hong Kong" --local-port 7900
# New local nodes use aes-128-gcm and an independent random password.
# The local port belongs to the Surge device, not to the VPS.

# Required when local nodes are enabled (macOS LaunchAgent).
# --no-local-node skips both local-node integrations.
SINGBOX_CONFIG=
SINGBOX_BINARY=sing-box
SINGBOX_SERVICE_LABEL=

# AliDNS credentials for public VPS mode; retained on the VPS for TLS renewal.
OKP_ALI_ACCESS_KEY_ID=
OKP_ALI_ACCESS_KEY_SECRET=
OKP_ACME_EMAIL=

# Optional installation defaults. Missing values are collected interactively.
# OKP_MODE=public
# OKP_FQDN=hk1.example.com
# OKP_NODE_NAME=hk1-reality
# OKP_ENABLE_IPV6=false
# OKP_REALITY_TARGET=www.cloudflare.com:443
# OKP_PUBLIC_IPV4=203.0.113.10
# OKP_PANEL_PORT=2053
# OKP_NODE_PORT=443
# OKP_SUB_PORT=2096
# NAT mode instead uses these external:internal mappings:
# OKP_MODE=nat
# OKP_PANEL_MAP=56664:2053
# OKP_NODE_MAP=56665:443
# OKP_SUB_MAP=56666:2096
