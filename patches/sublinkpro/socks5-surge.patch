+func buildSocks5SurgeLine(link string, config OutputConfig) (string, string, error) {
+	socks5, err := DecodeSocks5URL(link)
+	if err != nil {
+		return "", "", err
+	}
+	server := replaceSurgeHost(socks5.Server, config)
+	port := utils.GetPortInt(socks5.Port)
+	if server == "" || port < 1 || port > 65535 || strings.Contains(socks5.Name, "=") {
+		return "", "", fmt.Errorf("invalid SOCKS5 endpoint or Surge policy name")
+	}
+	for _, value := range []string{socks5.Name, server, socks5.Username, socks5.Password} {
+		if strings.ContainsAny(value, ",\r\n\"") {
+			return "", "", fmt.Errorf("SOCKS5 Surge fields contain unsupported delimiters")
+		}
+	}
+	line := fmt.Sprintf("%s = socks5, %s, %d", socks5.Name, server, port)
+	if socks5.Username != "" {
+		line += ", username=" + socks5.Username
+	}
+	if socks5.Password != "" {
+		line += ", password=" + socks5.Password
+	}
+	line = fmt.Sprintf("%s, udp-relay=%t", line, config.Udp)
+	return line, socks5.Name, nil
+}
